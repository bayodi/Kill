// Button component with variants
const Button = ({ children, href, onClick, variant = "primary", className = "", icon: Icon }) => {
  const base =
    "group inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl font-medium transition-all duration-300";
  const styles = {
    primary:
      `text-slate-900 bg-emerald-300 hover:bg-emerald-200 ${neonRingGreen}`,
    ghost:
      "text-white/90 hover:text-white border border-white/10 bg-white/5 hover:bg-white/10",
    outline:
      "text-emerald-300 border border-emerald-300/40 hover:bg-emerald-300/10",
  };
  const content = (
    <span className={`${base} ${styles[variant]} ${className}`} onClick={onClick}>
      {Icon && <Icon className="h-5 w-5" />}
      {children}
      <ArrowRight className="h-4 w-4 opacity-80 -mr-1 transition-transform group-hover:translate-x-1" />
    </span>
  );
  return href ? (
    <a href={href} target="_blank" rel="noreferrer" aria-label={typeof children === 'string' ? children : 'Open link'}>
      {content}
    </a>
  ) : (
    content
  );
};

